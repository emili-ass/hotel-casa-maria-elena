---
/**
 * Iconos del sitio, dibujados en línea (sin librerías).
 * Son decorativos: el texto que los acompaña es el que se lee.
 */
interface Props {
  nombre: 'whatsapp' | 'telefono' | 'pin' | 'reloj' | 'correo' | 'facebook' | 'estrella' | 'google' | 'anterior' | 'siguiente' | 'pausa' | 'reproducir' | 'cerrar';
  class?: string;
}

const { nombre, class: clase = 'size-5' } = Astro.props;
const relleno = ['whatsapp', 'facebook', 'estrella', 'google', 'pausa', 'reproducir'].includes(nombre);
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill={relleno ? 'currentColor' : 'none'}
  stroke={relleno ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nombre === 'whatsapp' && (
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    )
  }
  {
    nombre === 'facebook' && (
      <path d="M13.5 21.9v-8.4h2.8l.45-3.3H13.5V8.1c0-.95.27-1.6 1.63-1.6h1.75V3.55c-.3-.04-1.34-.13-2.55-.13-2.52 0-4.25 1.54-4.25 4.37v2.41H7.25v3.3h2.83v8.4Z" />
    )
  }
  {
    nombre === 'google' && (
      <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z" />
    )
  }
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nombre === 'anterior' && <path d="M15 5l-7 7 7 7" />}
  {nombre === 'siguiente' && <path d="M9 5l7 7-7 7" />}
  {nombre === 'pausa' && <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />}
  {nombre === 'reproducir' && <path d="M8 5.2v13.6a.6.6 0 0 0 .92.5l10.6-6.8a.6.6 0 0 0 0-1L8.92 4.7a.6.6 0 0 0-.92.5Z" />}
  {
    nombre === 'estrella' && (
      <path d="M12 2.6l2.85 6.05 6.65.8-4.9 4.55 1.3 6.55L12 17.3l-5.9 3.25 1.3-6.55-4.9-4.55 6.65-.8Z" />
    )
  }
  {
    nombre === 'telefono' && (
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
    )
  }
  {
    nombre === 'pin' && (
      <>
        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
        <circle cx="12" cy="10" r="3" />
      </>
    )
  }
  {
    nombre === 'reloj' && (
      <>
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </>
    )
  }
  {
    nombre === 'correo' && (
      <>
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </>
    )
  }
</svg>
