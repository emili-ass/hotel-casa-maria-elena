---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import Icono from '../components/Icono.astro';
import Pendiente from '../components/Pendiente.astro';
import { hotel, type Idioma } from '../data/negocio';
import { habitaciones } from '../data/habitaciones';
import { ruta } from '../i18n/rutas';
import { t, hora } from '../i18n/textos';
import { mensajeWhatsApp, baseWhatsApp, eventoWhatsApp } from '../lib/whatsapp';
import { enFrase } from '../lib/texto';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const h = textos.habitaciones;

const precio = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 0,
});

const nombreServicio = (clave: string) => hotel.servicios.find((s) => s.clave === clave)?.[idioma];

const base = baseWhatsApp('hotel');

const tarjetas = habitaciones.map((habitacion, indice) => {
  const numero = indice + 1;
  // El mensaje conserva "{fecha}" para que el campo de fecha lo complete.
  const plantilla = mensajeWhatsApp({
    intencion: 'habitacion',
    idioma,
    datos: { tipo: habitacion.nombre?.[idioma] ?? h.tipoMensaje(numero) },
  });
  return {
    ...habitacion,
    numero,
    titulo: habitacion.nombre?.[idioma] ?? h.tipo(numero),
    plantilla,
    enlace: `${base}?text=${encodeURIComponent(plantilla.replace('{fecha}', h.fecha.vacio))}`,
    alReves: indice % 2 === 1,
  };
});
---

<Base idioma={idioma} pagina="habitaciones" titulo={h.titulo} descripcion={h.descripcion}>
  <section class="contenedor pt-10 pb-12 lg:pt-16 lg:pb-16">
    <h1 class="text-pagina">{h.titulo}</h1>
    <p class="mt-5 max-w-[50ch] text-entrada text-tinta-suave">{h.entrada}</p>

    <div class="mt-8 max-w-sm">
      <label for="fecha-llegada" class="block font-semibold">{h.fecha.etiqueta}</label>
      <input
        type="date"
        id="fecha-llegada"
        name="fecha"
        aria-describedby="fecha-ayuda"
        data-vacio={h.fecha.vacio}
        class="mt-2 block min-h-12 w-full rounded-lg border border-tinta/35 bg-white px-4 py-2.5 text-base text-tinta"
      />
      <p id="fecha-ayuda" class="mt-2 text-sm text-tinta-suave">{h.fecha.ayuda}</p>
    </div>
  </section>

  <div class="contenedor space-y-16 pb-20 lg:space-y-28 lg:pb-28">
    {
      tarjetas.map((habitacion) => (
        <article
          id={habitacion.clave}
          class="grid gap-6 lg:grid-cols-12 lg:items-center lg:gap-8"
          aria-labelledby={`titulo-${habitacion.clave}`}
        >
          <div
            class:list={[
              'lg:col-span-7 lg:row-start-1',
              habitacion.alReves ? 'lg:col-start-6' : 'lg:col-start-1',
            ]}
          >
            <Picture
              src={habitacion.foto}
              alt={habitacion.fotoAlt[idioma]}
              formats={['avif', 'webp']}
              widths={[480, 768, 1080, 1440]}
              sizes="(min-width: 64rem) 55vw, 100vw"
              loading={habitacion.numero === 1 ? 'eager' : 'lazy'}
              class="aspect-[4/3] w-full object-cover"
            />
          </div>

          <div
            class:list={[
              'lg:col-span-4 lg:row-start-1',
              habitacion.alReves ? 'lg:col-start-1' : 'lg:col-start-9',
            ]}
          >
            <h2 id={`titulo-${habitacion.clave}`} class="text-seccion">
              {habitacion.titulo}
            </h2>
            {!habitacion.nombre && (
              <p class="mt-2">
                <Pendiente que={h.pendientes.nombre} />
              </p>
            )}

            <dl class="mt-6 border-t border-cantera-300">
              <div class="flex items-baseline justify-between gap-6 border-b border-cantera-300 py-3">
                <dt class="text-tinta-suave">{h.capacidad}</dt>
                <dd class="text-right font-medium">
                  {habitacion.capacidad ? (
                    h.personas(habitacion.capacidad)
                  ) : (
                    <Pendiente que={h.pendientes.capacidad} />
                  )}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-6 border-b border-cantera-300 py-3">
                <dt class="text-tinta-suave">{h.camas}</dt>
                <dd class="text-right font-medium">
                  {habitacion.camas ? (
                    habitacion.camas[idioma]
                  ) : (
                    <Pendiente que={h.pendientes.camas} />
                  )}
                </dd>
              </div>
              <div class="border-b border-cantera-300 py-3">
                <dt class="text-tinta-suave">{h.incluye}</dt>
                <dd class="mt-1">
                  {
                    enFrase(
                      habitacion.servicios
                        .map(nombreServicio)
                        .filter((nombre): nombre is string => Boolean(nombre)),
                    )
                  }
                </dd>
              </div>
            </dl>

            <p class="mt-6">
              {habitacion.precioDesde ? (
                <>
                  <span class="text-tinta-suave">{h.desde}</span>
                  <span class="mx-1 font-titulo text-[2.5rem] leading-none font-semibold">
                    {precio.format(habitacion.precioDesde)}
                  </span>
                  <span class="text-tinta-suave">{h.porNoche}</span>
                </>
              ) : (
                <>
                  <span class="text-tinta-suave">{h.desde}</span>{' '}
                  <Pendiente que={h.pendientes.precio} />
                </>
              )}
            </p>

            <Boton
              href={habitacion.enlace}
              evento={eventoWhatsApp({ intencion: 'habitacion' }) + '_' + habitacion.clave}
              externo
              class="mt-5 w-full sm:w-auto"
              data-base={base}
              data-mensaje={habitacion.plantilla}
            >
              <Icono nombre="whatsapp" />
              {h.reservarEsta}
            </Boton>
          </div>
        </article>
      ))
    }
  </div>

  <section class="bg-cantera-100">
    <div class="contenedor grid gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <div class="lg:col-span-7">
        <h2 class="text-seccion">{h.serviciosTitulo}</h2>
        <ul class="mt-8 grid gap-x-8 sm:grid-cols-2">
          {
            hotel.servicios.map((servicio) => (
              <li class="border-t border-cantera-300 py-3">{servicio[idioma]}</li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <h2 class="text-seccion">{h.horariosTitulo}</h2>
        <dl class="mt-8 border-t border-cantera-300">
          <div class="flex items-baseline justify-between gap-6 border-b border-cantera-300 py-3">
            <dt>{textos.horarios.checkIn}</dt>
            <dd class="font-titulo text-2xl leading-none font-semibold whitespace-nowrap">
              {hora(hotel.checkIn, idioma)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-cantera-300 py-3">
            <dt>{textos.horarios.checkOut}</dt>
            <dd class="font-titulo text-2xl leading-none font-semibold whitespace-nowrap">
              {hora(hotel.checkOut, idioma)}
            </dd>
          </div>
        </dl>
        {!hotel.aceptaMascotas && <p class="mt-4 text-tinta-suave">{h.mascotas}</p>}
        <p class="mt-4">
          <a
            href={ruta('politicas', idioma)}
            class="font-semibold text-barro underline underline-offset-4 hover:text-tinta"
          >
            {h.verPoliticas}
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Escribe la fecha elegida dentro del mensaje de WhatsApp de cada habitación.
  // Sin JavaScript los botones siguen funcionando: el mensaje dice "[fecha]".
  const campo = document.querySelector<HTMLInputElement>('#fecha-llegada');
  const botones = document.querySelectorAll<HTMLAnchorElement>('a[data-mensaje]');

  if (campo && botones.length > 0) {
    const hoy = new Date();
    const dosDigitos = (n: number) => String(n).padStart(2, '0');
    campo.min = `${hoy.getFullYear()}-${dosDigitos(hoy.getMonth() + 1)}-${dosDigitos(hoy.getDate())}`;

    const formato = new Intl.DateTimeFormat(document.documentElement.lang || 'es-MX', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    const actualizar = () => {
      let fecha = campo.dataset.vacio ?? '';
      if (campo.value) {
        const [anio, mes, dia] = campo.value.split('-').map(Number);
        fecha = formato.format(new Date(anio, mes - 1, dia));
      }
      botones.forEach((boton) => {
        const mensaje = (boton.dataset.mensaje ?? '').replace('{fecha}', fecha);
        boton.href = `${boton.dataset.base}?text=${encodeURIComponent(mensaje)}`;
      });
    };

    campo.addEventListener('change', actualizar);
    campo.addEventListener('input', actualizar);
    actualizar();
  }
</script>
