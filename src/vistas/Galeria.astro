---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import type { Idioma } from '../data/negocio';
import { galeria, categoriasGaleria } from '../data/galeria';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const g = t(idioma).galeria;

// Versión grande de cada foto, para el visor (y para quien navega sin JavaScript).
const fotos = await Promise.all(
  galeria.map(async (item, indice) => ({
    ...item,
    indice,
    grande: (await getImage({ src: item.foto, width: 1600, format: 'webp' })).src,
  })),
);

const grupos = categoriasGaleria
  .map((categoria) => ({
    ...categoria,
    fotos: fotos.filter((foto) => foto.categoria === categoria.clave),
  }))
  .filter((grupo) => grupo.fotos.length > 0);
---

<Base idioma={idioma} pagina="galeria" titulo={g.titulo} descripcion={g.descripcion}>
  <section class="contenedor pt-10 pb-8 lg:pt-16">
    <h1 class="text-pagina">{g.titulo}</h1>
    <p class="mt-5 max-w-[50ch] text-entrada text-tinta-suave">{g.entrada}</p>
  </section>

  <nav
    class="sticky top-16 z-20 border-y border-cantera-300 bg-cal/95 backdrop-blur-sm lg:top-20 print:hidden"
    aria-label={g.secciones}
  >
    <div class="contenedor">
      <ul class="indice -mx-5 flex gap-6 overflow-x-auto px-5 font-medium whitespace-nowrap md:mx-0 md:px-0">
        {
          grupos.map((grupo) => (
            <li>
              <a
                href={`#${grupo.clave}`}
                class="inline-flex min-h-12 items-center underline decoration-transparent underline-offset-8 transition-colors hover:decoration-cantera-300"
              >
                {grupo.nombre[idioma]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="contenedor pb-20 lg:pb-28">
    {
      grupos.map((grupo, numeroGrupo) => (
        <section id={grupo.clave} class="grupo pt-12 lg:pt-16" aria-labelledby={`galeria-${grupo.clave}`}>
          <h2 id={`galeria-${grupo.clave}`} class="text-seccion">
            {grupo.nombre[idioma]}
          </h2>
          <ul class="mt-6 columns-2 gap-3 lg:mt-8 lg:columns-3 lg:gap-6">
            {grupo.fotos.map((item, numeroFoto) => (
              <li class="mb-3 break-inside-avoid lg:mb-6">
                <a
                  href={item.grande}
                  class="foto block"
                  data-foto={item.indice}
                  data-alt={item.alt[idioma]}
                  aria-label={`${g.ampliar}: ${item.alt[idioma]}`}
                >
                  <Picture
                    src={item.foto}
                    alt={item.alt[idioma]}
                    formats={['avif', 'webp']}
                    widths={[300, 480, 720, 960]}
                    sizes="(min-width: 64rem) 30vw, 46vw"
                    loading={numeroGrupo === 0 && numeroFoto < 2 ? 'eager' : 'lazy'}
                    class="w-full"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <dialog class="visor" aria-label={g.visor} data-visor>
    <div class="visor-caja">
      <img class="visor-foto" alt="" data-visor-foto />
      <div class="visor-pie">
        <p class="visor-texto" data-visor-texto></p>
        <p class="visor-cuenta" aria-hidden="true" data-visor-cuenta></p>
      </div>
    </div>
    <button type="button" class="visor-boton visor-cerrar" aria-label={g.cerrar} data-visor-cerrar>
      <Icono nombre="cerrar" class="size-6" />
    </button>
    <button type="button" class="visor-boton visor-anterior" aria-label={g.anterior} data-visor-anterior>
      <Icono nombre="anterior" class="size-6" />
    </button>
    <button type="button" class="visor-boton visor-siguiente" aria-label={g.siguiente} data-visor-siguiente>
      <Icono nombre="siguiente" class="size-6" />
    </button>
  </dialog>
</Base>

<style>
  .indice {
    scrollbar-width: none;
  }

  .indice::-webkit-scrollbar {
    display: none;
  }

  .grupo {
    scroll-margin-top: 7.5rem;
  }

  .foto {
    cursor: zoom-in;
    overflow: hidden;
    background-color: var(--color-cantera-100);
  }

  @media (prefers-reduced-motion: no-preference) {
    .foto :global(img) {
      transition: transform 0.5s var(--ease-suave);
    }

    .foto:hover :global(img) {
      transform: scale(1.03);
    }
  }

  /* Visor de fotos a pantalla completa */
  .visor {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: rgb(43 33 27 / 0.96);
    color: var(--color-cal);
  }

  .visor::backdrop {
    background-color: rgb(43 33 27 / 0.96);
  }

  .visor-caja {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4rem 1rem 1.25rem;
  }

  .visor-foto {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    flex: 0 1 auto;
    object-fit: contain;
  }

  .visor-pie {
    display: flex;
    width: 100%;
    max-width: 60rem;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: 0.9375rem;
  }

  .visor-cuenta {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  .visor-boton {
    position: absolute;
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background-color: rgb(250 246 239 / 0.14);
    color: var(--color-cal);
    cursor: pointer;
  }

  .visor-boton:hover {
    background-color: rgb(250 246 239 / 0.28);
  }

  .visor-boton:focus-visible {
    outline-color: var(--color-cal);
  }

  .visor-cerrar {
    top: 0.75rem;
    right: 0.75rem;
  }

  .visor-anterior,
  .visor-siguiente {
    top: 50%;
    transform: translateY(-50%);
  }

  .visor-anterior {
    left: 0.75rem;
  }

  .visor-siguiente {
    right: 0.75rem;
  }

  @media (width < 48rem) {
    .visor-anterior,
    .visor-siguiente {
      top: auto;
      bottom: 4.5rem;
      transform: none;
    }

    .visor-caja {
      padding-bottom: 8.5rem;
    }

    .visor-pie {
      position: absolute;
      right: 1rem;
      bottom: 1.25rem;
      left: 1rem;
      width: auto;
    }
  }
</style>

<script>
  // Visor de fotos: abre la foto grande sin salir de la página.
  // Sin JavaScript, cada foto es un enlace normal a su versión grande.
  const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-foto]'));

  if (visor && enlaces.length > 0 && typeof visor.showModal === 'function') {
    const foto = visor.querySelector<HTMLImageElement>('[data-visor-foto]');
    const texto = visor.querySelector<HTMLElement>('[data-visor-texto]');
    const cuenta = visor.querySelector<HTMLElement>('[data-visor-cuenta]');
    let actual = 0;

    const mostrar = (indice: number) => {
      actual = (indice + enlaces.length) % enlaces.length;
      const enlace = enlaces[actual];
      const descripcion = enlace.dataset.alt ?? '';
      if (foto) {
        foto.src = enlace.href;
        foto.alt = descripcion;
      }
      if (texto) texto.textContent = descripcion;
      if (cuenta) cuenta.textContent = `${actual + 1} / ${enlaces.length}`;
    };

    enlaces.forEach((enlace, indice) => {
      enlace.addEventListener('click', (evento) => {
        // Con Ctrl, Cmd o Shift se respeta "abrir en otra pestaña".
        if (evento.ctrlKey || evento.metaKey || evento.shiftKey) return;
        evento.preventDefault();
        mostrar(indice);
        visor.showModal();
      });
    });

    visor.querySelector('[data-visor-cerrar]')?.addEventListener('click', () => visor.close());
    visor.querySelector('[data-visor-anterior]')?.addEventListener('click', () => mostrar(actual - 1));
    visor.querySelector('[data-visor-siguiente]')?.addEventListener('click', () => mostrar(actual + 1));

    visor.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowRight') mostrar(actual + 1);
      if (evento.key === 'ArrowLeft') mostrar(actual - 1);
    });

    // Un toque fuera de la foto cierra el visor.
    visor.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;
      if (objetivo === visor || objetivo.classList.contains('visor-caja')) visor.close();
    });

    // Al cerrar, el foco vuelve a la miniatura de la foto que se estaba viendo.
    visor.addEventListener('close', () => {
      if (foto) foto.removeAttribute('src');
      enlaces[actual]?.focus();
    });
  }
</script>
