---
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import Icono from '../components/Icono.astro';
import Pendiente from '../components/Pendiente.astro';
import { hotel, type Idioma } from '../data/negocio';
import { ruta } from '../i18n/rutas';
import { t, hora } from '../i18n/textos';
import { enlaceWhatsApp, eventoWhatsApp } from '../lib/whatsapp';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const p = textos.politicas;
const l = p.lista;

// Cada política: su título, su dato grande (si lo tiene), su texto y lo que falta confirmar.
const politicas = [
  {
    titulo: l.checkIn.titulo,
    dato: hora(hotel.checkIn, idioma),
    texto: l.checkIn.texto(hora(hotel.checkIn, idioma)),
  },
  {
    titulo: l.checkOut.titulo,
    dato: hora(hotel.checkOut, idioma),
    texto: l.checkOut.texto(hora(hotel.checkOut, idioma)),
  },
  {
    titulo: l.mascotas.titulo,
    texto: hotel.aceptaMascotas ? l.mascotas.si : l.mascotas.no,
  },
  {
    titulo: l.cancelacion.titulo,
    texto: hotel.cancelacion?.[idioma],
    pendiente: hotel.cancelacion ? undefined : l.cancelacion.pendiente,
  },
  {
    titulo: l.facturacion.titulo,
    texto: l.facturacion.texto,
    pendiente: l.facturacion.pendiente,
  },
];
---

<Base idioma={idioma} pagina="politicas" titulo={p.titulo} descripcion={p.descripcion}>
  <section class="contenedor pt-10 pb-16 lg:pt-16 lg:pb-24">
    <h1 class="text-pagina">{p.titulo}</h1>
    <p class="mt-5 max-w-[50ch] text-entrada text-tinta-suave">{p.entrada}</p>

    <dl class="mt-10 border-t border-cantera-300 lg:mt-14">
      {
        politicas.map((politica) => (
          <div class="grid gap-2 border-b border-cantera-300 py-7 lg:grid-cols-12 lg:gap-8 lg:py-9">
            <dt class="font-titulo text-subtitulo font-semibold lg:col-span-4">{politica.titulo}</dt>
            <dd class="lg:col-span-7 lg:col-start-6">
              {politica.dato && (
                <p class="font-titulo text-[2.5rem] leading-none font-semibold">{politica.dato}</p>
              )}
              {politica.texto && (
                <p class:list={['max-w-[52ch]', politica.dato && 'mt-2 text-tinta-suave']}>
                  {politica.texto}
                </p>
              )}
              {politica.pendiente && (
                <p class="mt-2">
                  <Pendiente que={politica.pendiente} />
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-cantera-100">
    <div class="contenedor flex flex-col gap-6 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-16">
      <p class="font-titulo text-subtitulo font-semibold">{p.dudas}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Boton
          href={enlaceWhatsApp({ intencion: 'general', idioma })}
          evento={eventoWhatsApp({ intencion: 'general' }) + '_politicas'}
          externo
        >
          <Icono nombre="whatsapp" />
          {textos.acciones.whatsapp}
        </Boton>
        <Boton href={ruta('ubicacion', idioma)} variante="secundario">
          {textos.paginas.ubicacion}
        </Boton>
      </div>
    </div>
  </section>
</Base>
