---
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import type { Idioma } from '../data/negocio';
import { t } from '../i18n/textos';
import { aviso } from '../i18n/privacidad';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const p = t(idioma).privacidad;
const contenido = aviso[idioma];
---

<Base idioma={idioma} pagina="privacidad" titulo={p.titulo} descripcion={p.descripcion}>
  <article class="contenedor pt-10 pb-20 lg:pt-16 lg:pb-28">
    <h1 class="text-pagina">{p.titulo}</h1>
    <p class="mt-5">
      <Pendiente que={p.pendiente} />
    </p>
    {contenido.nota && <p class="mt-4 max-w-[62ch] text-tinta-suave">{contenido.nota}</p>}

    <div class="mt-10 max-w-[62ch]">
      {
        contenido.secciones.map((seccion) => (
          <section class="border-t border-cantera-300 py-8">
            <h2 class="text-subtitulo">{seccion.titulo}</h2>
            {seccion.parrafos.map((parrafo) => (
              <p class="mt-3">{parrafo}</p>
            ))}
            {seccion.pendiente && (
              <p class="mt-3">
                <Pendiente que={seccion.pendiente} />
              </p>
            )}
          </section>
        ))
      }
    </div>
  </article>
</Base>
